# Keycloak production — auth.cybervem.com
# Image: https://github.com/lennylin-lab/knowledge-base-keycloak/releases

KEYCLOAK_HOSTNAME=auth.cybervem.com
KEYCLOAK_IMAGE=ghcr.io/lennylin-lab/knowledge-base-keycloak:v1.0.0

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

KEYCLOAK_DB_PASSWORD=change-me

# Cloudflare Turnstile (widget hostname: auth.cybervem.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# post-import.sh (optional overrides)
# KEYCLOAK_REALM=CyberVem
# KEYCLOAK_CONTAINER=knowledge-base-keycloak-prod
# KEYCLOAK_URL=http://127.0.0.1:8080
