# Copy to keycloak/.env — Keycloak runtime and bootstrap config.
# Compose injects KC_DB_* from shared KEYCLOAK_DB_* in .env.prod.

# --- host port (loopback-only in compose) ---
KEYCLOAK_HOST_PORT=8080

KEYCLOAK_CONTAINER=knowledge-base-keycloak-prod
# Required for production `start` mode — compose maps this to KC_HOSTNAME.
KEYCLOAK_HOSTNAME=auth.example.com
# Optional overrides (compose passes through when set here):
# KC_HOSTNAME_STRICT=false
# KC_HOSTNAME_STRICT_HTTPS=false
KEYCLOAK_REALM=CyberVem

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Cloudflare Turnstile — required for --profile bootstrap.
# Dev test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# post-import.sh (optional overrides when running from host)
# KEYCLOAK_URL=http://127.0.0.1:8080
