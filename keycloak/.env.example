# --- Keycloak production (auth.cybervem.com) ---

KEYCLOAK_HOSTNAME=auth.cybervem.com
KEYCLOAK_IMAGE=kb-keycloak:26.0-prod

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

KEYCLOAK_DB_PASSWORD=change-me

# Cloudflare Turnstile (widget domain: auth.cybervem.com)
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used by post-import.sh (defaults match docker-compose service names)
# KEYCLOAK_URL=http://127.0.0.1:8080
# KEYCLOAK_REALM=CyberVem
# KEYCLOAK_CONTAINER=knowledge-base-keycloak-prod
