# Shared infrastructure for the unified stack.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   cp gateway/.env.example gateway/.env
#   cp server/.env.example server/.env
#   cp keycloak/.env.example keycloak/.env
#
# Start (compose merges all env files for interpolation + container env):
#   docker compose \
#     --env-file .env.prod \
#     --env-file gateway/.env \
#     --env-file server/.env \
#     --env-file keycloak/.env \
#     -f docker-compose.prod.yml up -d

# --- PostgreSQL superuser (init + healthcheck) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- logical databases (created by docker/postgres/init on first boot) ---
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=change-me
GATEWAY_DB_NAME=gateway

KB_DB_USER=kb
KB_DB_PASSWORD=change-me
KB_DB_NAME=kb

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak

# Optional: full DSN overrides when passwords contain URI-reserved characters (/ ? # @ :).
# Init script accepts any password (psql -v + format %L); compose DSN still needs URL-encoding.
# Encode the password (e.g. p%40ss) or set GATEWAY_DATABASE_URL / KB_DATABASE_URL below.
# GATEWAY_DATABASE_URL=postgres://gateway:encoded@postgres:5432/gateway?sslmode=disable
# KB_DATABASE_URL=postgresql+asyncpg://kb:encoded@postgres:5432/kb

# --- release images (GHCR) ---
GATEWAY_IMAGE=ghcr.io/lennylin-lab/knowledge-base-gateway:v1.3
SERVER_IMAGE=ghcr.io/lennylin-lab/knowledge-base-server:v0.1.0
KEYCLOAK_IMAGE=ghcr.io/lennylin-lab/knowledge-base-keycloak:v1.0.0
ELASTICSEARCH_IMAGE=ghcr.io/lennylin-lab/knowledge-base-server/elasticsearch:8.17.3-ik
