# Copy to server/.env — knowledge-base-server runtime config.
#
# Compose (docker-compose.prod.yml) injects and overrides:
#   KB_DATABASE_URL, KB_ELASTICSEARCH_URL, KB_REDIS_URL
#
# Host prerequisite (Linux): sysctl -w vm.max_map_count=262144 for Elasticsearch.

# --- host port (loopback-only; read by compose for port mappings) ---
SERVER_HOST_PORT=8000

# --- Elasticsearch heap (read by compose elasticsearch service, not server) ---
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- LLM via gateway (mint keys through gateway admin API — never upstream keys) ---
KB_CHAT_BASE_URL=http://gateway:8080/v1
KB_CHAT_API_KEY=change-me-gateway-service-key
# Optional since gateway v1.3: unset = discover gateway default at startup (needs
# a valid KB_CHAT_API_KEY). For first boot with seeded gateway-echo, set explicitly:
# KB_CHAT_MODEL=gateway-echo

KB_EMBEDDING_BASE_URL=http://gateway:8080/v1
KB_EMBEDDING_API_KEY=change-me-gateway-service-key
KB_EMBEDDING_MODEL=text-embedding-3-small
# Empty/unset = discover embedding_dim from gateway catalog; 1536 matches pgvector column.
KB_EMBEDDING_DIM=1536

# --- OIDC (enable after Keycloak realm + users are configured) ---
# KB_OIDC_ISSUER=https://auth.example.com/realms/CyberVem
# KB_OIDC_AUDIENCE=kb-api

# --- CORS (production: explicit origins; [] disables CORS) ---
KB_CORS_ORIGINS=[]

# --- queue + cache (KB_REDIS_URL injected by compose) ---
# With Redis configured, enable ARQ worker: docker compose ... --profile queue up -d worker
KB_CACHE_ENABLED=true
# KB_INDEX_JOB_MAX_TRIES=3
# KB_INDEX_JOB_RETRY_MIN_DELAY_S=5

# --- optional ---
# KB_ES_INDEX=kb_documents
# KB_MCP_CONFIG_PATH=mcp.json

KB_LOG_LEVEL=INFO
KB_LOG_FORMAT=json
