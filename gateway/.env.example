# Copy to gateway/.env — Gateway runtime secrets and host bindings.
#
# Compose (docker-compose.prod.yml) injects and overrides:
#   GATEWAY_DATABASE_URL, GATEWAY_LIMITS_MODE=redis, GATEWAY_REDIS_ADDR,
#   GATEWAY_ALLOW_INSECURE_BASE_URLS=false
#
# Fresh migrate seeds fake providers (gateway-echo) — no upstream keys required
# for /readyz. Production routes need credentials below (never on server).

# --- host ports (loopback-only; read by compose for port mappings) ---
GATEWAY_HOST_PORT=8091
GATEWAY_ADMIN_HOST_PORT=8092

# --- management API (required to mint KB_CHAT_API_KEY / KB_EMBEDDING_API_KEY) ---
GATEWAY_ADMIN_TOKEN=change-me
# GATEWAY_ADMIN_ADDR=:8081

# --- upstream provider keys (database-mode registry; per-row override wins) ---
# Registry name "openai-primary" -> OPENAI_API_KEY__OPENAI_PRIMARY
# Registry name "openai-embed"   -> OPENAI_API_KEY__OPENAI_EMBED
# Fallback for any openai/anthropic row without a per-provider var:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# bootstrap-openai.sh imports chat + embedding catalog (defaults from dev DB):
#   GATEWAY_OPENAI_CHAT_BASE_URL=https://api.longxiadev.store/v1
#   GATEWAY_OPENAI_EMBED_BASE_URL=https://router.tumuer.me/v1
#   GATEWAY_OPENAI_CHAT_MODEL=gpt-5.5
#   GATEWAY_OPENAI_EMBED_MODEL=qwen3-embedding

# --- optional rollback switches (default enabled when unset) ---
# GATEWAY_EMBEDDINGS_ENABLED=true
# GATEWAY_RESPONSES_ENABLED=true

# --- optional tuning (defaults: MAX_RETRIES=2, RATE_PER_MINUTE=120) ---
# GATEWAY_MAX_RETRIES=2
# GATEWAY_RATE_PER_MINUTE=120
